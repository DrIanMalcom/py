{
  "code-runner.executorMap": {
    "python": "python3 -u"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/python-prep/.venv/bin/python",
  "mypy-type-checker.importStrategy": "fromEnvironment",
  "mypy-type-checker.args": ["--config-file=${workspaceFolder}/python-prep/pyproject.toml"],
  "mypy-type-checker.reportingScope": "workspace"
}
